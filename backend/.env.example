# ============================================================================
# MEDCURE PLATFORM BACKEND ENVIRONMENT VARIABLES (.env.example)
# GORAKHPUR HUMAN & VETERINARY MEDICINE DELIVERY PILOT
# ============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development # development | staging | production

# Supabase Infrastructure (Separate instances for Dev, Staging, Prod)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Database Connection (Direct & Connection Pooling)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/postgres

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Payment Gateway (Razorpay / Cashfree HMAC Verification)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS Gateway (DLT Registered Provider for Indian Mobile Numbers)
SMS_GATEWAY_PROVIDER=mock # mock | gupshup | msg91
SMS_GATEWAY_API_KEY=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID_OTP=

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=medcure-pilot-gkp
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Storage Buckets (Private Healthcare Vaults)
STORAGE_BUCKET_PRESCRIPTIONS=medcure-prescriptions-private
STORAGE_BUCKET_PARTNER_DOCS=medcure-partner-documents-private

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH=5
RATE_LIMIT_MAX_API=100
RATE_LIMIT_MAX_AI=15

# AI Assistant Configuration
AI_PROVIDER=gemini # gemini | openai
AI_MODEL_NAME=gemini-1.5-flash
AI_API_KEY=
AI_DAILY_BUDGET_USD=10.00
