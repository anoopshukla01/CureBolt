# Medcure Platform - Backend Environment Configuration (.env.example)
# Do NOT commit actual secrets to version control.

# Database Connection (Supabase PostgreSQL 15+)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Server Configuration
PORT=4000
NODE_ENV=development
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# JWT Secret (for custom auth validation if not using Supabase Auth directly)
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_EXPIRATION=7d

# Payment Gateway (Razorpay Sandbox for Gorakhpur pilot testing)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayTestSecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# SMS Gateway (Fast2SMS / MSG91 for OTP)
SMS_GATEWAY_PROVIDER=mock # Options: mock | fast2sms | msg91
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=MDCURE

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=medcure-gkp
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@medcure-gkp.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Storage Vault (Private S3 / Supabase Storage for Prescriptions & Licences)
VAULT_BUCKET_NAME=medcure-vault-prescriptions
VAULT_SIGNED_URL_EXPIRY_SECONDS=900 # 15 minutes max per SAS

# AI Assistant Gateway (Gemini API / Groq)
AI_PROVIDER=gemini # Options: gemini | mock
GEMINI_API_KEY=your_google_gemini_api_key
AI_TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=500
