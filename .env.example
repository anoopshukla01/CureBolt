# ============================================================================
# MEDCURE PLATFORM GLOBAL CONFIGURATION (.env.example)
# ============================================================================

# Target Environment: development | staging | production
MEDCURE_ENV=development

# Service Ports
PORT=4000
WEB_PORT=3001

# Secrets Management Notes:
# - All production secrets must be provisioned via Google Cloud Secret Manager / Supabase Vault.
# - Service-role keys must NEVER be bundled in client web or mobile application bundles.
