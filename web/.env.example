# ============================================================================
# MEDCURE WEB & PWA ENVIRONMENT VARIABLES (.env.example)
# ============================================================================

# API Base URL
VITE_API_BASE=http://localhost:4000/api/v1

# Supabase Client (Public Anon Key Only - NEVER Service Role)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=

# Platform Environment
VITE_ENVIRONMENT=development # development | staging | production

# Web Push Credentials (FCM VAPID Key)
VITE_FCM_VAPID_KEY=
